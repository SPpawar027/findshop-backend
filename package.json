{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "module": "CommonJS",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "local": "npm run dev:local",
    "prod": "npm run dev:prod",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local tsx watch -r dotenv/config src/server.ts",
    "dev:development": "DOTENV_CONFIG_PATH=.env.development tsx watch -r dotenv/config src/server.ts",
    "dev:prod": "DOTENV_CONFIG_PATH=.env.production tsx watch -r dotenv/config src/server.ts",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "tsc && cp src/build-info.json dist/ 2>/dev/null || true",
    "migrate:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate",
    "migrate:undo:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate:undo",
    "migrate:dev": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate",
    "migrate:undo:dev": "DOTENV_CONFIG_PATH=.env.development node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate:undo",
    "migrate:prod": "DOTENV_CONFIG_PATH=.env.production node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate",
    "migrate:undo:prod": "DOTENV_CONFIG_PATH=.env.production node -r dotenv/config node_modules/.bin/sequelize-cli db:migrate:undo",
    "seed": "tsx src/database/seed.ts",
    "seed:local": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config src/database/seed-local-data.ts",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
