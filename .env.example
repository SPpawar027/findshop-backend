# Server Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection URL
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/findshop

# Storage Provider (s3 or local)
STORAGE_PROVIDER=s3

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=findshop-dev-media-sagar
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Public Media CDN / S3 Bucket Root URL
MEDIA_CDN_URL=https://findshop-dev-media-sagar.s3.ap-south-1.amazonaws.com

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=30d
