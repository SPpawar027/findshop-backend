# Server Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection URL
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/findshop

# Storage Provider Configuration
# Set to 's3' for Local Development & Staging (AWS S3)
# Set to 'r2' for Production (Cloudflare R2 - zero egress fees)
STORAGE_PROVIDER=s3

# -------------------------------------------------------------
# Option A: AWS S3 Configuration (Local & Development)
# -------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=findshop-dev-media-sagar
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# -------------------------------------------------------------
# Option B: Cloudflare R2 Configuration (Production)
# -------------------------------------------------------------
# Cloudflare Account ID from Cloudflare Dashboard -> R2 Overview
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=findshop-prod-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# -------------------------------------------------------------
# Public Media CDN / Storage Root URL
# -------------------------------------------------------------
# For AWS S3: https://<bucket>.s3.<region>.amazonaws.com
# For Cloudflare R2: https://media.findshopeasily.com (Custom Domain) or https://pub-<id>.r2.dev
MEDIA_CDN_URL=https://findshop-dev-media-sagar.s3.ap-south-1.amazonaws.com

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Mail / SMTP Configuration (Nodemailer)
# Works with Gmail App Password, Brevo, SendGrid, Amazon SES, or custom SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="FindShopEasily <no-reply@findshopeasily.com>"

# Merchant Store Admin Portal Base URL
SHOP_ADMIN_URL=http://localhost:3000
