# Server Configuration
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection URL
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/findshop

# Storage Provider Configuration (AWS S3)
STORAGE_PROVIDER=s3

# -------------------------------------------------------------
# AWS S3 Configuration (Local & Development)
# -------------------------------------------------------------
# Bucket: findshop-dev-media-sagar (or findshop-dev)
# Region: ap-south-1
AWS_REGION=ap-south-1
AWS_S3_BUCKET=findshop-dev-media-sagar
AWS_ACCESS_KEY_ID=your_dev_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_dev_aws_secret_access_key

# -------------------------------------------------------------
# AWS S3 Configuration (Production Environment)
# -------------------------------------------------------------
# Bucket: findshop-prod-media (or findshop-prod)
# Use separate IAM credentials or IAM Instance Profiles on EC2/ECS/EKS
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=findshop-prod-media
# AWS_ACCESS_KEY_ID=your_prod_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_prod_aws_secret_access_key

# -------------------------------------------------------------
# Public Media CDN / Storage Root URL
# -------------------------------------------------------------
# For AWS S3 / CloudFront: https://media.findshopeasily.com or https://<bucket>.s3.<region>.amazonaws.com
MEDIA_CDN_URL=https://findshop-dev-media-sagar.s3.ap-south-1.amazonaws.com

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Mail / SMTP Configuration (Nodemailer)
# Works with Gmail App Password, Brevo, SendGrid, Amazon SES, or custom SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="FindShopEasily <no-reply@findshopeasily.com>"